# Supabase Server Credentials (Service Role - NEVER expose to frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# TRON Network & TronGrid Configuration
TRON_FULL_HOST="https://api.trongrid.io"
# Optional comma-separated extra permitted HTTPS TronGrid/node origins (W-19)
TRON_ALLOWED_HOSTS=""
TRONGRID_API_KEY="your-trongrid-api-key"
USDT_CONTRACT_ADDRESS="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# Hot Wallet Key Protection (Production: ntps:v2 AES-256-GCM encrypted envelope, scrypt N=131072)
# Generate interactively (masked prompt) or via `--key-file`: npm run encrypt-key
HOT_WALLET_PRIVATE_KEY_ENCRYPTED=""
# Passphrase / secret key (min 32 chars required for ntps:v2). Store in secrets manager, not git.
HOT_WALLET_DECRYPTION_KEY=""

# Dev Fallback ONLY (refused when NODE_ENV=production unless ALLOW_PLAINTEXT_KEY=true)
# Leave both empty in production once HOT_WALLET_PRIVATE_KEY_ENCRYPTED is configured.
HOT_WALLET_PRIVATE_KEY=""
ALLOW_PLAINTEXT_KEY="false"

# Worker Polling, TRX Reserve, Lease Guard & Retry Configuration
# IMPORTANT: Deploy as a single active replica. Migration 008 enforces a DB lease guard.
POLL_INTERVAL_MS="15000"
WITHDRAWAL_RETRY_BASE_MS="2000"
POLL_FAILURE_ALERT_THRESHOLD="3"
STALE_BROADCAST_THRESHOLD_MS="600000"
MIN_HOT_WALLET_TRX="50"
WORKER_LEASE_TTL_SECONDS="45"

# Audit Failure Alerting & Append-Only Local Fallback Buffer
AUDIT_FAILURE_ALERT_THRESHOLD="3"
# Optional path override for redacted local JSONL fallback log (defaults to OS temp dir, mode 0600)
AUDIT_FALLBACK_FILE=""

# Failure Alerting Channels (Optional; configure webhook and/or same-origin Edge Function)
ALERT_WEBHOOK_URL=""
ALERT_EDGE_FUNCTION_URL=""
# Optional dedicated token for alert Edge Function (preferred over sending SUPABASE_SERVICE_ROLE_KEY)
ALERT_EDGE_FUNCTION_TOKEN=""

# Lightweight AML Screening (Optional comma-separated TRON addresses blocked in addition to DB table)
AML_BLOCKED_ADDRESSES=""
# W-03: Fail-closed AML policy (defaults to false). Never enable in production with real funds.
# Only set "true" temporarily if migration 004 (`aml_blocked_addresses`) has not yet been applied.
AML_ALLOW_DEGRADED_MODE="false"
