# Supabase Server Credentials (Service Role - NEVER expose to frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# TRON Network & TronGrid Configuration
TRON_FULL_HOST="https://api.trongrid.io"
TRONGRID_API_KEY="your-trongrid-api-key"
USDT_CONTRACT_ADDRESS="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# Hot Wallet Key Protection (Production: AES-256-GCM encrypted envelope)
# Generate using: npm run encrypt-key
HOT_WALLET_PRIVATE_KEY_ENCRYPTED=""
# Passphrase / secret key (min 16 chars; 32+ chars recommended). Store in secrets manager, not git.
HOT_WALLET_DECRYPTION_KEY=""

# Legacy/Dev Fallback ONLY (triggers startup security warning if used without ENCRYPTED key)
# Leave empty in production once HOT_WALLET_PRIVATE_KEY_ENCRYPTED is configured.
HOT_WALLET_PRIVATE_KEY=""

# Worker Polling & Retry Configuration
POLL_INTERVAL_MS="15000"
WITHDRAWAL_RETRY_BASE_MS="2000"
POLL_FAILURE_ALERT_THRESHOLD="3"

# Failure Alerting Channels (Optional; configure webhook and/or Edge Function)
ALERT_WEBHOOK_URL=""
ALERT_EDGE_FUNCTION_URL=""

# Lightweight AML Screening (Optional comma-separated TRON addresses blocked in addition to DB table)
AML_BLOCKED_ADDRESSES=""
