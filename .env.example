# ==============================================================================
# NOVA Terminal Payment System (NTPS) — Frontend Environment Configuration
# Copy to `.env.local` for local development or configure in your hosting CI.
# NEVER place service_role keys, hot wallet keys, or TOTP secrets in VITE_* vars.
# ==============================================================================

# Supabase Project Credentials (Required for Live Auth, RLS, RPCs & Realtime)
# Leave empty to run the application in sandboxed Local Demo Mode.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Public application URL (optional; used for deployment reference)
APP_URL="http://localhost:3000"
